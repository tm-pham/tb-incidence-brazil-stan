# ---------------------------------------------------------------------------
# Data: never track raw, interim, or processed data (privacy and size).
# Keep the directory structure (.gitkeep) and the documenting README.md.
# data/synthetic/ IS tracked: it is generated by the simulator and safe to share.
# ---------------------------------------------------------------------------
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/raw/README.md
!data/interim/README.md
!data/processed/README.md

# ---------------------------------------------------------------------------
# Literature: do not commit the private PDFs (copyright). Keep the structure
# and the README. references.bib and notes/ are tracked.
# ---------------------------------------------------------------------------
literature/private_pdfs/*
!literature/private_pdfs/.gitkeep
!literature/private_pdfs/README.md

# ---------------------------------------------------------------------------
# Outputs: regenerable artefacts. Track only the directory structure.
# ---------------------------------------------------------------------------
outputs/**
!outputs/
!outputs/**/
!outputs/**/.gitkeep

# ---------------------------------------------------------------------------
# targets store
# ---------------------------------------------------------------------------
_targets/

# ---------------------------------------------------------------------------
# renv: track the lockfile and settings, ignore the local library/cache.
# ---------------------------------------------------------------------------
renv/library/
renv/staging/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/

# ---------------------------------------------------------------------------
# R session / IDE
# ---------------------------------------------------------------------------
.Rproj.user/
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Renviron
.vscode/
*.code-workspace

# ---------------------------------------------------------------------------
# Compiled Stan artefacts (sit next to the .stan files, no extension)
# ---------------------------------------------------------------------------
code/03_modeling/stan/*
!code/03_modeling/stan/*.stan
!code/03_modeling/stan/.gitkeep
*.o
*.so
*.dll
*.exe
*.stanc
*.hpp

# ---------------------------------------------------------------------------
# OS / temp / logs
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
*.log
*.tmp
tmp/
